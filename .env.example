# Copy this file to .env and fill in real values before `docker compose up`.
# Nothing here needs to be real to run Phase 0 except the DB/Redis URLs, which
# already point at the docker-compose services below by default.

# --- Postgres (matches docker-compose.yml `db` service) ---
POSTGRES_USER=mwtv
POSTGRES_PASSWORD=mwtv
POSTGRES_DB=mwtv
DATABASE_URL=postgresql+asyncpg://mwtv:mwtv@db:5432/mwtv

# --- Redis (Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Supabase (Auth + Storage) ---
# Not set up yet — placeholders below are enough for the backend to boot.
# GET /health works with no auth. GET /organizations/me needs a real Supabase
# project: create one at https://supabase.com, then set these three from
# Project Settings > API (SUPABASE_JWT_SECRET is under API > JWT Settings).
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_JWT_SECRET=placeholder-jwt-secret

# --- Backend ---
ENV=development
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite reads these; must be prefixed VITE_) ---
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key
